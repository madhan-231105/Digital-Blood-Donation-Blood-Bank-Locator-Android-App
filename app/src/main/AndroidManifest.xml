<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.bloodlink">

    <!-- ================= PERMISSIONS ================= -->

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ================= APPLICATION ================= -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BloodLink">

        <!-- ================= GOOGLE MAPS API KEY ================= -->

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_GOOGLE_MAPS_API_KEY_HERE"/>

        <!-- ================= WELCOME (LAUNCHER) ================= -->

        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- ================= USER LOGIN ================= -->

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"/>

        <!-- ================= ADMIN LOGIN ================= -->

        <activity
            android:name=".activities.AdminLoginActivity"
            android:exported="false"/>

        <!-- ================= ADMIN REGISTER ================= -->

        <activity
            android:name=".activities.AdminRegisterActivity"
            android:exported="false"/>

        <!-- ================= USER REGISTER ================= -->

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"/>

        <!-- ================= USER DASHBOARD ================= -->

        <activity
            android:name=".activities.MainActivity"
            android:exported="false"/>

        <!-- ================= ADMIN DASHBOARD (ADD THIS IF NOT ADDED) ================= -->

        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false"/>

        <!-- ================= NOTIFICATIONS ================= -->

        <activity
            android:name=".activities.NotificationActivity"
            android:exported="false"/>

        <!-- ================= MAP ================= -->

        <activity
            android:name=".activities.NearbyMapActivity"
            android:exported="false"/>

        <!-- ================= BLOOD REQUEST ================= -->

        <activity
            android:name=".activities.RequestBloodActivity"
            android:exported="false"/>

        <!-- ================= EDIT PROFILE ================= -->

        <activity
            android:name=".activities.EditProfileActivity"
            android:exported="false"/>
        <activity android:name=".activities.DonorListActivity"/>

        <!-- ================= BACKGROUND SERVICE ================= -->

        <service
            android:name=".services.EmergencyNotificationService"
            android:exported="false"/>

    </application>

</manifest>
